msgstr "WEB-T API-Einstellungen"

#: includes/Settings.php:26
msgid "API Endpoint URL"
msgstr "URL des API-Endpunkts"

#: includes/Settings.php:34
msgid "Application Name"
msgstr "Anwendungsname"

#: includes/Settings.php:42
msgid "Password"
msgstr "Passwort"

#: includes/Settings.php:52 includes/Settings.php:53 includes/Settings.php:100
msgid "WEB-T Translator"
