#. Plugin Name of the plugin
#: rrze-webt.php
msgid "RRZE WEB-T Translator"
msgstr "RRZE WEB-T Übersetzer"

#. Plugin URI of the plugin
#: rrze-webt.php
msgid "https://github.com/RRZE-Webteam/rrze-webt"
msgstr "https://github.com/RRZE-Webteam/rrze-webt"

#. Description of the plugin
#: rrze-webt.php
msgid ""
"Integrates the WEB-T translation API into the block editor to translate post "
"content while editing."
msgstr ""
"Integriert die WEB-T-Übersetzungs-API in den Blockeditor, um Post-Inhalte "
"während der Bearbeitung zu übersetzen."

#. Author of the plugin
#: rrze-webt.php
msgid "RRZE Webteam"
msgstr "RRZE-Webteam"

#. Author URI of the plugin
#: rrze-webt.php
msgid "https://blogs.fau.de/webworking/"
msgstr "https://blogs.fau.de/webworking/"

#: includes/EditorAssets.php:57 build/editor.js:1 src/editor.js:30
msgid "WEB-T Translation"
msgstr "WEB-T-Übersetzung"

#: includes/EditorAssets.php:58 build/editor.js:1 src/editor.js:525
msgid "Translate content"
msgstr "Inhalte übersetzen"

#: includes/EditorAssets.php:59 build/editor.js:1 src/editor.js:513
msgid "Target language"
msgstr "Zielsprache"

#: includes/EditorAssets.php:60 build/editor.js:1 src/editor.js:501
msgid "Source language"
msgstr "Ausgangssprache"

#: includes/EditorAssets.php:61 build/editor.js:1 src/editor.js:320
msgid "Auto detect"
msgstr "Automatizierte Erkennung"

#: includes/EditorAssets.php:62 build/editor.js:1 src/editor.js:493
msgid ""
"Please provide the WEB-T application name and password to enable "
"translations."
msgstr ""
"Bitte geben Sie den Namen und das Passwort der WEB-T-Anwendung an, um "
"Übersetzungen zu ermöglichen."

#: includes/EditorAssets.php:63 build/editor.js:1 src/editor.js:525
msgid "Translating…"
msgstr "Übersetzen…"

#: includes/EditorAssets.php:64
msgid "Content translated with WEB-T."
msgstr "Mit WEB-T übersetzte Inhalte."

#: includes/EditorAssets.php:65
msgid "Translation failed. Check the console for details."
msgstr ""
"Die Übersetzung ist fehlgeschlagen. Weitere Informationen finden Sie in der "
"Konsole."

#: includes/EditorAssets.php:66 build/editor.js:1 src/editor.js:91
msgid ""
"Translation request submitted. The translated content will appear "
"automatically once ready."
msgstr ""
"Übersetzungsanfrage eingereicht. Der übersetzte Inhalt wird automatisch "
"angezeigt, sobald er fertig ist."

#: includes/EditorAssets.php:67 build/editor.js:1 src/editor.js:92
msgid "The translation service reported a failure."
msgstr "Der Übersetzungsdienst hat einen Fehler gemeldet."

