#: includes/Settings.php:61
msgid ""
"Configure the credentials used to communicate with the WEB-T translation API."
msgstr ""
"Konfigurieren Sie die Anmeldeinformationen, die für die Kommunikation mit "
"der WEB-T-Übersetzungs-API verwendet werden."

#: includes/WebTClient.php:91
msgid "Please configure the WEB-T application name and password first."
msgstr ""
"Bitte konfigurieren Sie zuerst den Namen und das Passwort der WEB-T-"
"Anwendung."

#. translators: %1$d: HTTP status code, %2$s: response body
#: includes/WebTClient.php:209
#, php-format
msgid "The WEB-T API returned an unexpected status code (%1$d): %2$s"
msgstr ""
"Die WEB-T-API hat einen unerwarteten Statuscode (%1$d) zurückgegeben: %2$s"

#: includes/WebTClient.php:243 includes/WebTClient.php:275
msgid "The WEB-T service rejected the translation request."
msgstr "Der WEB-T-Dienst hat die Übersetzungsanforderung abgelehnt."

#: includes/WebTClient.php:284
msgid "The WEB-T API reported an error."
msgstr "Die WEB-T-API hat einen Fehler gemeldet."

#: includes/WebTClient.php:290
msgid "The WEB-T API returned an invalid response."
msgstr "Die WEB-T-API hat eine ungültige Antwort zurückgegeben."

#: includes/WebTClient.php:338
msgid "The WEB-T API response did not include a translation."
msgstr "Die WEB-T-API-Antwort enthielt keine Übersetzung."

#: includes/WebTClient.php:495
msgid "Unable to obtain the authentication challenge from the WEB-T service."
msgstr ""
"Die Authentifizierungsabfrage vom WEB-T-Dienst kann nicht abgerufen werden."

#: includes/WebTClient.php:512
msgid "The WEB-T service returned an invalid authentication challenge."
msgstr ""
"Der WEB-T-Dienst hat eine ungültige Authentifizierungsaufforderung "
"zurückgegeben."

#: includes/WebTClient.php:614
msgid "Empty response from the WEB-T service."
msgstr "Leere Antwort vom WEB-T-Dienst."

