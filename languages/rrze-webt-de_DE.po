#: includes/RestController.php:112
msgid "There is no content to translate."
msgstr "Es gibt keinen Inhalt zu übersetzen."

#: includes/RestController.php:116
msgid "The selected target language is not allowed."
msgstr "Die ausgewählte Zielsprache ist nicht erlaubt."

#: includes/RestController.php:158
msgid "The translation request was submitted to WEB-T."
msgstr "Die Übersetzungsanfrage wurde an WEB-T übermittelt."

#: includes/RestController.php:180
msgid "The raw post content to translate."
msgstr "Der Rohinhalt des Posts, der übersetzt werden soll."

#: includes/RestController.php:185
msgid "The target language code."
msgstr "Der Code der Zielsprache."

#: includes/RestController.php:190
msgid "Optional source language code."
msgstr "Optionaler Code in der Quellsprache."

#: includes/RestController.php:196
msgid "The current post ID to validate permissions."
msgstr "Die aktuelle Beitrags-ID zum Überprüfen von Berechtigungen."

#: includes/RestController.php:202
msgid "The post title to translate."
msgstr "Der Titel des zu übersetzenden Beitrags."

#: includes/RestController.php:323
msgid "The WEB-T service reported an unspecified error."
msgstr "Der WEB-T-Dienst hat einen nicht näher bezeichneten Fehler gemeldet."

#: includes/RestController.php:349
msgid "WEB-T callback payload is not valid JSON."
msgstr "Die WEB-T-Callback-Nutzlast ist kein gültiges JSON."

#: includes/RestController.php:358
msgid "WEB-T callback payload is missing the translated content."
msgstr "In der WEB-T-Callback-Payload fehlt der übersetzte Inhalt."

#: includes/RestController.php:364
msgid "WEB-T callback content is not valid base64."
msgstr "WEB-T-Callback-Inhalte sind nicht gültig, Base64."

#: includes/RestController.php:386
msgid "WEB-T callback did not include any content."
msgstr "Der WEB-T-Callback enthielt keinen Inhalt."

