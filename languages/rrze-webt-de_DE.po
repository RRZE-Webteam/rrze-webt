#. Plugin Name of the plugin
#: rrze-webt.php
msgid "RRZE WEB-T Translator"
msgstr "RRZE WEB-T Übersetzer"

#. Plugin URI of the plugin
#: rrze-webt.php
msgid "https://github.com/RRZE-Webteam/rrze-webt"
msgstr "https://github.com/RRZE-Webteam/rrze-webt"

#. Description of the plugin
#: rrze-webt.php
msgid ""
"Integrates the WEB-T translation API into the block editor to translate post "
"content while editing."
msgstr ""
"Integriert die WEB-T-Übersetzungs-API in den Blockeditor, um Post-Inhalte "
"während der Bearbeitung zu übersetzen."

#. Author of the plugin
#: rrze-webt.php
msgid "RRZE Webteam"
msgstr "RRZE-Webteam"

#. Author URI of the plugin
#: rrze-webt.php
msgid "https://blogs.fau.de/webworking/"
msgstr "https://blogs.fau.de/webworking/"

